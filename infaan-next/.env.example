# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long-please"
JWT_ACCESS_LIFETIME="7d"
JWT_REFRESH_LIFETIME="30d"

# App URL (used for redirects / CORS behavior)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (authorization code flow, same as Django)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Allowed CORS origins (comma separated; mirrors Django CORS_ALLOWED_ORIGINS)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
