# Database (SQLite for local dev; PostgreSQL/Neon in production)
DATABASE_URL="file:./dev.db"

# JWT secrets (generate with: openssl rand -hex 64) — REQUIRED in production
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long-please"
JWT_ACCESS_LIFETIME="7d"
JWT_REFRESH_LIFETIME="30d"

# Google OAuth (authorization code flow)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Allowed CORS origins (comma separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Base URL used for managed-system API callbacks
SYSTEM_SUBSCRIPTION_API_URL="http://localhost:3000/api"
